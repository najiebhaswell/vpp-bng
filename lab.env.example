# Site settings for the lab scripts. Copy to lab.env (not committed) on the BNG router and on the machine
# that drives the BNG Blaster and RADIUS runs.

# BNG router (VPP + accel-ppp) over ssh, and this repository's path on it
BR=user@192.0.2.10
BR_DIR=/home/user/vpp-bng
# BNG Blaster host cabled to the router, and where its bngblaster/bngblaster-cli live
BB=user@192.0.2.20
BB_BIN=/usr/sbin
# RADIUS host over ssh (only for the RADIUS test: CoA/DM via coa.sh and the radacct detail files in COA_DIR)
RAD=user@192.0.2.30
COA_DIR=radius

# accel-ppp RADIUS client
RADIUS_SERVER=192.0.2.30
RADIUS_SECRET=testing123
NAS_IP=192.0.2.10
NAS_ID=bng-lab
# RADIUS subscribers are <SUB_USER><n> with password SUB_PASS (see README for the per-user attributes)
SUB_USER=user
SUB_PASS=password

# optional: an address beyond the router that capture-test.sh pings through VPP
EXT_PING=
