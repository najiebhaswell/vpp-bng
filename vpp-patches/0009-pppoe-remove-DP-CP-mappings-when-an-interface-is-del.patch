From 58cba660f754ef2642b4fe732b628613f7642198 Mon Sep 17 00:00:00 2001
From: najiebhaswell <25635833+najiebhaswell@users.noreply.github.com>
Date: Tue, 3 Nov 2026 09:39:31 +0700
Subject: [PATCH 9/9] pppoe: remove DP/CP mappings when an interface is deleted

The mapping tables are indexed by sw_if_index and were never cleared on
interface delete, so a new interface that reused the index inherited the
stale mapping and a new mapping for the CP interface was refused.
---
 src/plugins/pppoe/pppoe_cp.c | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/src/plugins/pppoe/pppoe_cp.c b/src/plugins/pppoe/pppoe_cp.c
index fcca79c37..16665ad0b 100644
--- a/src/plugins/pppoe/pppoe_cp.c
+++ b/src/plugins/pppoe/pppoe_cp.c
@@ -61,6 +61,29 @@ pppoe_add_del_cp (u32 cp_if_index, u32 dp_if_index, u8 is_add)
   return 0;
 }
 
+static clib_error_t *
+pppoe_cp_sw_interface_add_del (vnet_main_t *vnm, u32 sw_if_index, u32 is_add)
+{
+  pppoe_main_t *pem = &pppoe_main;
+  u32 peer;
+
+  if (is_add)
+    return 0;
+
+  /* drop mappings of a deleted interface, its index can be reused */
+  if (sw_if_index < vec_len (pem->cp_if_index_by_sw_if_index) &&
+      (peer = pem->cp_if_index_by_sw_if_index[sw_if_index]) != ~0)
+    pppoe_add_del_cp (peer, sw_if_index, 0);
+
+  if (sw_if_index < vec_len (pem->dp_if_index_by_sw_if_index) &&
+      (peer = pem->dp_if_index_by_sw_if_index[sw_if_index]) != ~0)
+    pppoe_add_del_cp (sw_if_index, peer, 0);
+
+  return 0;
+}
+
+VNET_SW_INTERFACE_ADD_DEL_FUNCTION (pppoe_cp_sw_interface_add_del);
+
 static clib_error_t *
 pppoe_add_del_cp_command_fn (vlib_main_t * vm,
 			     unformat_input_t * input,
