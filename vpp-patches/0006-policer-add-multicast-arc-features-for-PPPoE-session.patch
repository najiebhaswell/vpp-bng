From 2a7193b55d23fb059453c957c2e101b9c00bf3e0 Mon Sep 17 00:00:00 2001
From: najiebhaswell <25635833+najiebhaswell@users.noreply.github.com>
Date: Tue, 3 Nov 2026 08:56:19 +0700
Subject: [PATCH 6/9] policer: add multicast arc features for PPPoE sessions

Port of VyOS patch 0018 to the policer plugin. policer_input() already
enables the ip4-unicast and ip6-unicast features since 26.10, so only the
multicast arcs are registered here. They are enabled by the control plane.
---
 src/plugins/policer/policer_node.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/plugins/policer/policer_node.c b/src/plugins/policer/policer_node.c
index 9639423b3..9a35d18d3 100644
--- a/src/plugins/policer/policer_node.c
+++ b/src/plugins/policer/policer_node.c
@@ -367,6 +367,17 @@ VNET_FEATURE_INIT (policer_ip6_unicast, static) = {
   .runs_before = VNET_FEATURES ("ip6-lookup"),
 };
 
+/* Register on IP multicast arcs for L3 interfaces such as PPPoE sessions */
+VNET_FEATURE_INIT (policer_ip4_multicast, static) = {
+  .arc_name = "ip4-multicast",
+  .node_name = "policer-input",
+};
+
+VNET_FEATURE_INIT (policer_ip6_multicast, static) = {
+  .arc_name = "ip6-multicast",
+  .node_name = "policer-input",
+};
+
 VLIB_NODE_FN (policer_output_node)
 (vlib_main_t *vm, vlib_node_runtime_t *node, vlib_frame_t *frame)
 {
