+
 } snat_main_per_thread_data_t;
 
 struct snat_main_s;
@@ -577,6 +600,16 @@ typedef struct snat_main_s
 
   /* counters */
   vlib_simple_counter_main_t total_sessions;
+  /* per-user limits (0: unlimited); tracking is on while any is set */
