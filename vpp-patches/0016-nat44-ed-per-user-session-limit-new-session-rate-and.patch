From 3d1f5a8f8d79027ea97b3cc827d7b04a1f080573 Mon Sep 17 00:00:00 2001
From: najiebhaswell <25635833+najiebhaswell@users.noreply.github.com>
Date: Fri, 6 Nov 2026 15:56:30 +0700
Subject: [PATCH] nat44-ed: per-user session limit, new session rate and alarm

Type: feature

One inside address (subscriber) can exhaust a worker's ports or session
table for everybody. set nat44 user limit [sessions <n>] [rate <n>]
[alarm <percent>] bounds what one inside address holds at once and how
fast it opens new sessions (token bucket, one second of burst), checked
in the slow path before a port is taken. A user crossing the alarm
percentage of its session limit is counted once in
/nat44-ed/user-alarms and /nat44-ed/users-over-alarm (cleared ten
points below); /nat44-ed/users gauges the tracked users. show nat44
users lists them, most sessions first, with how they spread over the
limit. Off by default; nothing is tracked until a limit is set.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/plugins/nat/nat44-ed/nat44_ed.c         |  37 +++++
 src/plugins/nat/nat44-ed/nat44_ed.h         |  36 ++++-
 src/plugins/nat/nat44-ed/nat44_ed_cli.c     | 171 ++++++++++++++++++++
 src/plugins/nat/nat44-ed/nat44_ed_in2out.c  |  31 ++++
 src/plugins/nat/nat44-ed/nat44_ed_inlines.h | 144 +++++++++++++++++
 5 files changed, 418 insertions(+), 1 deletion(-)

diff --git a/src/plugins/nat/nat44-ed/nat44_ed.c b/src/plugins/nat/nat44-ed/nat44_ed.c
index b3dea1d1f..d6059c1b6 100644
--- a/src/plugins/nat/nat44-ed/nat44_ed.c
+++ b/src/plugins/nat/nat44-ed/nat44_ed.c
@@ -2355,6 +2355,11 @@ nat_init (vlib_main_t * vm)
 
   nat_init_simple_counter (sm->total_sessions, "total-sessions",
 			   "/nat44-ed/total-sessions");
+  nat_init_simple_counter (sm->users, "users", "/nat44-ed/users");
+  nat_init_simple_counter (sm->users_over_alarm, "users-over-alarm",
+			   "/nat44-ed/users-over-alarm");
+  nat_init_simple_counter (sm->user_alarms, "user-alarms",
+			   "/nat44-ed/user-alarms");
   sm->max_cfg_sessions_gauge =
     vlib_stats_add_gauge ("/nat44-ed/max-cfg-sessions");
 
@@ -3256,6 +3261,30 @@ nat44_set_session_limit (u32 session_limit, u32 vrf_id)
   return 0;
 }
 
+/* Per-user limits, 0 for unlimited; tracking runs while any is set. Sessions
+ * that exist when it is turned on are not counted. */
+int
+nat44_ed_set_user_limits (u32 max_sessions, u32 max_rate, u8 alarm_pct)
+{
+  snat_main_t *sm = &snat_main;
+
+  if (alarm_pct > 100 || (alarm_pct && !max_sessions))
+    return VNET_API_ERROR_INVALID_VALUE;
+
+  sm->max_sessions_per_user = max_sessions;
+  sm->max_session_rate_per_user = max_rate;
+  sm->user_alarm_pct = alarm_pct;
+  sm->user_alarm_sessions =
+    alarm_pct ? clib_max (1, (u64) max_sessions * alarm_pct / 100) : 0;
+  /* ten points of hysteresis */
+  sm->user_alarm_clear =
+    alarm_pct ? (u64) max_sessions * (alarm_pct > 10 ? alarm_pct - 10 : 0) /
+		  100 :
+		0;
+  sm->user_limits_enabled = max_sessions || max_rate;
+  return 0;
+}
+
 int
 nat44_update_session_limit (u32 session_limit, u32 vrf_id)
 {
@@ -3284,6 +3313,9 @@ nat44_ed_worker_db_init (snat_main_per_thread_data_t *tsm, u32 translations)
   pool_alloc (tsm->sessions, translations);
   pool_alloc (tsm->lru_pool, translations);
 
+  tsm->user_by_key = hash_create (0, sizeof (uword));
+  tsm->n_users_over_alarm = 0;
+
   pool_get (tsm->lru_pool, head);
   tsm->tcp_trans_lru_head_index = head - tsm->lru_pool;
   clib_dlist_init (tsm->lru_pool, tsm->tcp_trans_lru_head_index);
@@ -3336,6 +3368,9 @@ nat44_ed_worker_db_free (snat_main_per_thread_data_t *tsm)
   pool_free (tsm->lru_pool);
   pool_free (tsm->sessions);
   pool_free (tsm->per_vrf_sessions_pool);
+  pool_free (tsm->users);
+  hash_free (tsm->user_by_key);
+  tsm->n_users_over_alarm = 0;
 }
 
 static void
@@ -3368,6 +3403,8 @@ nat44_ed_sessions_clear ()
   nat44_ed_db_free ();
   nat44_ed_db_init ();
   vlib_zero_simple_counter (&sm->total_sessions, 0);
+  vlib_zero_simple_counter (&sm->users, 0);
+  vlib_zero_simple_counter (&sm->users_over_alarm, 0);
 }
 
 static void
