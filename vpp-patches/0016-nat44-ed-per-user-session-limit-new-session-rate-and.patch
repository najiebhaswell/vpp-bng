+static clib_error_t *
+nat44_set_user_limit_command_fn (vlib_main_t *vm, unformat_input_t *input,
+				 vlib_cli_command_t *cmd)
+{
+  unformat_input_t _line_input, *line_input = &_line_input;
+  snat_main_t *sm = &snat_main;
+  clib_error_t *error = 0;
+  u32 sessions = sm->max_sessions_per_user;
+  u32 rate = sm->max_session_rate_per_user;
+  u32 alarm = sm->user_alarm_pct;
+
+  if (!unformat_user (input, unformat_line_input, line_input))
+    return clib_error_return (0, NAT44_ED_EXPECTED_ARGUMENT);
+
+  while (unformat_check_input (line_input) != UNFORMAT_END_OF_INPUT)
+    {
+      if (unformat (line_input, "sessions %u", &sessions))
+	;
+      else if (unformat (line_input, "rate %u", &rate))
+	;
+      else if (unformat (line_input, "alarm %u", &alarm))
+	;
+      else if (unformat (line_input, "disable"))
+	sessions = rate = alarm = 0;
+      else
+	{
+	  error = clib_error_return (0, "unknown input '%U'",
+				     format_unformat_error, line_input);
+	  goto done;
+	}
+    }
+
+  if (alarm > 100 || nat44_ed_set_user_limits (sessions, rate, alarm))
+    error = clib_error_return (
+      0, "alarm is a percentage of a session limit, 1-100");
+
+done:
+  unformat_free (line_input);
+  return error;
+}
+
+/*?
+ * @cliexpar
+ * @cliexstart{set nat44 user limit}
+ * Bound what one inside address (subscriber) may hold, 0 for unlimited:
+ * sessions it holds at once, new sessions a second (one second of burst), and
+ * the percentage of the session limit at which it is counted once in
+ * /nat44-ed/user-alarms and /nat44-ed/users-over-alarm (cleared ten points
+ * below). Sessions that exist when limits are first set are not counted.
+ *  vpp# set nat44 user limit sessions 2000 rate 200 alarm 75
+ * @cliexend
+?*/
+VLIB_CLI_COMMAND (nat44_set_user_limit_command, static) = {
+  .path = "set nat44 user limit",
+  .short_help = "set nat44 user limit [sessions <n>] [rate <n>] "
+		"[alarm <percent>] | disable",
+  .function = nat44_set_user_limit_command_fn,
+};
+
+typedef struct
+{
+  nat44_ed_user_t u;
+  u32 thread_index;
+} nat44_ed_user_row_t;
+
+static int
+nat44_ed_user_row_cmp (void *a1, void *a2)
+{
+  nat44_ed_user_row_t *r1 = a1, *r2 = a2;
+  return (r2->u.n_sessions > r1->u.n_sessions) -
+	 (r2->u.n_sessions < r1->u.n_sessions);
+}
+
+static clib_error_t *
+nat44_show_users_command_fn (vlib_main_t *vm, unformat_input_t *input,
+			     vlib_cli_command_t *cmd)
+{
+  snat_main_t *sm = &snat_main;
+  snat_main_per_thread_data_t *tsm;
+  nat44_ed_user_row_t *rows = 0, *r;
+  nat44_ed_user_t *u;
+  u32 top = 20, min = 0, n_users = 0, n_over = 0;
+  u32 hist[5] = { 0 };
+
+  while (unformat_check_input (input) != UNFORMAT_END_OF_INPUT)
+    {
+      if (unformat (input, "top %u", &top))
+	;
+      else if (unformat (input, "min %u", &min))
+	;
+      else
+	return clib_error_return (0, "unknown input '%U'",
+				  format_unformat_error, input);
+    }
+
+  vlib_cli_output (vm,
+		   "per-user limits: sessions %u, rate %u/s, alarm %u%% "
+		   "(at %u, cleared below %u)%s",
+		   sm->max_sessions_per_user, sm->max_session_rate_per_user,
+		   sm->user_alarm_pct, sm->user_alarm_sessions,
+		   sm->user_alarm_clear,
+		   sm->user_limits_enabled ? "" : " - off, nothing tracked");
+
+  vec_foreach (tsm, sm->per_thread_data)
+    {
+      n_over += tsm->n_users_over_alarm;
+      pool_foreach (u, tsm->users)
+	{
+	  n_users++;
+	  if (sm->max_sessions_per_user)
+	    {
+	      /* <50% 50-74% 75-89% 90-99% 100% of the limit */
+	      u32 pct = (u64) u->n_sessions * 100 / sm->max_sessions_per_user;
+	      hist[pct >= 100 ? 4 : pct >= 90 ? 3 : pct >= 75 ? 2 :
+		   pct >= 50 ? 1 : 0]++;
+	    }
+	  if (u->n_sessions < min)
+	    continue;
+	  vec_add2 (rows, r, 1);
+	  r->u = *u;
+	  r->thread_index = tsm - sm->per_thread_data;
+	}
+    }
+
+  vlib_cli_output (vm, "users: %u, over alarm: %u", n_users, n_over);
+  if (sm->max_sessions_per_user)
+    vlib_cli_output (vm,
+		     "of the session limit:  <50%%: %u  50-74%%: %u  "
+		     "75-89%%: %u  90-99%%: %u  100%%: %u",
+		     hist[0], hist[1], hist[2], hist[3], hist[4]);
+
+  vec_sort_with_function (rows, nat44_ed_user_row_cmp);
+  if (vec_len (rows))
+    vlib_cli_output (vm, "%-16s %6s %6s %9s %8s %5s", "inside", "fib",
+		     "thread", "sessions", "tokens", "alarm");
+  vec_foreach (r, rows)
+    {
+      if (r - rows >= top)
+	break;
+      vlib_cli_output (vm, "%-16U %6u %6u %9u %8.1f %5s", format_ip4_address,
+		       &r->u.addr, r->u.fib_index, r->thread_index,
+		       r->u.n_sessions, r->u.tokens, r->u.alarm ? "yes" : "");
+    }
+  vec_free (rows);
+  return 0;
+}
+
+/*?
+ * @cliexpar
+ * @cliexstart{show nat44 users}
+ * Inside addresses tracked by the per-user limits, most sessions first, with
+ * how the users spread over the session limit.
+ *  vpp# show nat44 users top 10
+ * @cliexend
+?*/
+VLIB_CLI_COMMAND (nat44_show_users_command, static) = {
+  .path = "show nat44 users",
+  .short_help = "show nat44 users [top <n>] [min <sessions>]",
+  .function = nat44_show_users_command_fn,
+};
+
