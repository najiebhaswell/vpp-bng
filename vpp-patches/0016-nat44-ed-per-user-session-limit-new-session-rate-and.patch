 }
@@ -907,6 +924,7 @@ nat44_ed_in2out_slowpath_unknown_proto (snat_main_t *sm, vlib_buffer_t *b,
   int i;
   ip4_address_t new_src_addr = { 0 };
   ip4_address_t new_dst_addr = ip->dst_address;
+  u32 user_index = ~0;
 
   if (PREDICT_FALSE (
 	nat44_ed_maximum_sessions_exceeded (sm, rx_fib_index, thread_index)))
@@ -929,6 +947,14 @@ nat44_ed_in2out_slowpath_unknown_proto (snat_main_t *sm, vlib_buffer_t *b,
     }
   else
     {
+      /* per-user limits, before the walk below: a refused user costs nothing */
