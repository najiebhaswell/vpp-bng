diff --git a/src/plugins/nat/nat44-ed/nat44_ed_inlines.h b/src/plugins/nat/nat44-ed/nat44_ed_inlines.h
index 51f28327b..cd928c86a 100644
--- a/src/plugins/nat/nat44-ed/nat44_ed_inlines.h
+++ b/src/plugins/nat/nat44-ed/nat44_ed_inlines.h
@@ -300,6 +300,148 @@ nat_ed_ses_o2i_flow_hash_add_del (snat_main_t *sm, u32 thread_idx,
   return clib_bihash_add_del_16_8 (&sm->flow_hash, &kv, is_add);
 }
 
+/* Per-user limits. A user is an inside address (subscriber) with dynamic
+ * sessions on one thread: in2out handoff by source address keeps all of a
+ * subscriber's sessions on one worker, so the counts need no locking. Only the
+ * slow path (a new session) and session delete touch them. */
+
+static_always_inline u64
+nat44_ed_user_key (ip4_address_t addr, u32 fib_index)
+{
+  return ((u64) fib_index << 32) | addr.as_u32;
+}
+
+static_always_inline void
+nat44_ed_user_gauges (snat_main_t *sm, snat_main_per_thread_data_t *tsm)
+{
+  u32 ti = tsm - sm->per_thread_data;
+  vlib_set_simple_counter (&sm->users, ti, 0, pool_elts (tsm->users));
+  vlib_set_simple_counter (&sm->users_over_alarm, ti, 0,
+			   tsm->n_users_over_alarm);
+}
+
+static_always_inline void
+nat44_ed_user_free (snat_main_t *sm, snat_main_per_thread_data_t *tsm,
+		    nat44_ed_user_t *u)
+{
+  if (u->alarm)
+    tsm->n_users_over_alarm--;
+  hash_unset (tsm->user_by_key, nat44_ed_user_key (u->addr, u->fib_index));
+  pool_put (tsm->users, u);
+  nat44_ed_user_gauges (sm, tsm);
+}
+
+/* Before a dynamic session is created: 0 to go on, with *user_index the user
+ * to commit the session to (~0 when limits are off), or the in2out error that
+ * refuses it. */
+static_always_inline int
+nat44_ed_user_admit (snat_main_t *sm, u32 thread_index, ip4_address_t addr,
+		     u32 fib_index, f64 now, u32 *user_index)
+{
+  snat_main_per_thread_data_t *tsm = &sm->per_thread_data[thread_index];
+  nat44_ed_user_t *u;
+  uword *p;
+
+  *user_index = ~0;
+  if (PREDICT_TRUE (!sm->user_limits_enabled))
+    return 0;
+
+  p = hash_get (tsm->user_by_key, nat44_ed_user_key (addr, fib_index));
+  if (p)
+    u = pool_elt_at_index (tsm->users, p[0]);
+  else
+    {
+      pool_get_zero (tsm->users, u);
+      u->addr = addr;
+      u->fib_index = fib_index;
+      hash_set (tsm->user_by_key, nat44_ed_user_key (addr, fib_index),
+		u - tsm->users);
+      nat44_ed_user_gauges (sm, tsm);
+    }
+
+  if (sm->max_sessions_per_user && u->n_sessions >= sm->max_sessions_per_user)
+    return NAT_IN2OUT_ED_ERROR_USER_SESSION_LIMIT;
+
+  if (sm->max_session_rate_per_user)
+    {
+      f32 rate = sm->max_session_rate_per_user;
+      /* a new user starts full: now - 0 refills far past one second */
+      u->tokens = clib_min (rate, u->tokens + (now - u->last_refill) * rate);
+      u->last_refill = now;
+      if (u->tokens < 1)
+	return NAT_IN2OUT_ED_ERROR_USER_SESSION_RATE;
+      u->tokens -= 1;
+    }
+
+  *user_index = u - tsm->users;
+  return 0;
+}
+
+/* The session admitted for user_index was not created after all */
+static_always_inline void
+nat44_ed_user_abort (snat_main_t *sm, u32 thread_index, u32 user_index)
+{
+  snat_main_per_thread_data_t *tsm = &sm->per_thread_data[thread_index];
+  nat44_ed_user_t *u;
+
+  if (user_index == ~0 || pool_is_free_index (tsm->users, user_index))
+    return;
+  u = pool_elt_at_index (tsm->users, user_index);
+  if (!u->n_sessions)
+    nat44_ed_user_free (sm, tsm, u);
+}
+
+/* The session admitted for user_index exists */
+static_always_inline void
+nat44_ed_user_commit (snat_main_t *sm, u32 thread_index, u32 user_index,
+		      snat_session_t *s)
+{
+  snat_main_per_thread_data_t *tsm = &sm->per_thread_data[thread_index];
+  nat44_ed_user_t *u;
+
+  if (user_index == ~0 || pool_is_free_index (tsm->users, user_index))
+    return;
+  u = pool_elt_at_index (tsm->users, user_index);
+  u->n_sessions++;
+  s->flags |= SNAT_SESSION_FLAG_USER_COUNTED;
+  /* once per crossing, not per session past the threshold */
+  if (sm->user_alarm_sessions && !u->alarm &&
+      u->n_sessions >= sm->user_alarm_sessions)
+    {
+      u->alarm = 1;
+      tsm->n_users_over_alarm++;
+      vlib_increment_simple_counter (&sm->user_alarms, thread_index, 0, 1);
+      nat44_ed_user_gauges (sm, tsm);
+    }
+}
+
+static_always_inline void
+nat44_ed_user_session_del (snat_main_t *sm, snat_main_per_thread_data_t *tsm,
+			   snat_session_t *s)
+{
+  nat44_ed_user_t *u;
+  uword *p;
+
+  s->flags &= ~SNAT_SESSION_FLAG_USER_COUNTED;
+  p = hash_get (tsm->user_by_key,
+		nat44_ed_user_key (s->in2out.addr, s->in2out.fib_index));
+  if (!p)
+    return;
+  u = pool_elt_at_index (tsm->users, p[0]);
+  if (u->n_sessions)
+    u->n_sessions--;
+  if (u->alarm && u->n_sessions < sm->user_alarm_clear)
+    {
+      u->alarm = 0;
+      tsm->n_users_over_alarm--;
+      nat44_ed_user_gauges (sm, tsm);
+    }
+  /* the last session gone: forget the user (a new one starts with a full
+   * bucket; a scan holds its sessions for their timeouts, so never gets here) */
+  if (!u->n_sessions)
+    nat44_ed_user_free (sm, tsm, u);
+}
