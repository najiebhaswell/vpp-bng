+	}
       pool_foreach (s, tsm->sessions)
 	{
 	  if (s->ext_host_addr.as_u32 == ip->dst_address.as_u32)
@@ -962,6 +988,7 @@ nat44_ed_in2out_slowpath_unknown_proto (snat_main_t *sm, vlib_buffer_t *b,
   if (!new_src_addr.as_u32)
     {
       // could not allocate address for translation ...
+      nat44_ed_user_abort (sm, thread_index, user_index);
       return 0;
     }
 
@@ -970,6 +997,7 @@ nat44_ed_in2out_slowpath_unknown_proto (snat_main_t *sm, vlib_buffer_t *b,
     {
       b->error = node->errors[NAT_IN2OUT_ED_ERROR_MAX_SESSIONS_EXCEEDED];
       nat_elog_warn (sm, "create NAT session failed");
+      nat44_ed_user_abort (sm, thread_index, user_index);
       return 0;
     }
 
@@ -1005,6 +1033,7 @@ nat44_ed_in2out_slowpath_unknown_proto (snat_main_t *sm, vlib_buffer_t *b,
     {
       nat_elog_notice (sm, "in2out flow hash add failed");
       nat_ed_session_delete (sm, s, thread_index, 1);
