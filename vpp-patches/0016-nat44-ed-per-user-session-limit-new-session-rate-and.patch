+  /* new-session token bucket, one second of the configured rate deep */
+  f32 tokens;
+  f64 last_refill;
+} nat44_ed_user_t;
+
 typedef struct
 {
   /* Session pool */
@@ -466,6 +484,11 @@ typedef struct
 
   per_vrf_sessions_t *per_vrf_sessions_pool;
 
+  /* per-user limits: users by (fib_index << 32 | inside address) */
