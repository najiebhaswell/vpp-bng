--- a/drivers/net/ppp/pppoe.c
+++ b/drivers/net/ppp/pppoe.c
@@ -54,6 +54,7 @@
 
 #include <linux/string.h>
 #include <linux/module.h>
+#include <linux/jhash.h>
 #include <linux/kernel.h>
 #include <linux/slab.h>
 #include <linux/errno.h>
@@ -80,7 +81,9 @@
 
 #include <linux/uaccess.h>
 
-#define PPPOE_HASH_BITS CONFIG_PPPOE_HASH_BITS
+/* BNG: thousands of sessions per BNG; the stock 16 buckets turn every session-frame lookup into a walk over
+ * thousands of entries. 8192 buckets, hashed with jhash. */
+#define PPPOE_HASH_BITS 13
 #define PPPOE_HASH_SIZE (1 << PPPOE_HASH_BITS)
 #define PPPOE_HASH_MASK	(PPPOE_HASH_SIZE - 1)
 
@@ -132,23 +135,14 @@
 	return a->sid == sid && ether_addr_equal(a->remote, addr);
 }
 
-#if 8 % PPPOE_HASH_BITS
-#error 8 must be a multiple of PPPOE_HASH_BITS
-#endif
 
 static int hash_item(__be16 sid, unsigned char *addr)
 {
-	unsigned char hash = 0;
-	unsigned int i;
+	u32 a, b = 0;
 
-	for (i = 0; i < ETH_ALEN; i++)
-		hash ^= addr[i];
-	for (i = 0; i < sizeof(sid_t) * 8; i += 8)
-		hash ^= (__force __u32)sid >> i;
-	for (i = 8; (i >>= 1) >= PPPOE_HASH_BITS;)
-		hash ^= hash >> i;
-
-	return hash & PPPOE_HASH_MASK;
+	memcpy(&a, addr, 4);
+	memcpy(&b, addr + 4, 2);
+	return jhash_3words(a, b, (__force u32)sid, 0) & PPPOE_HASH_MASK;
 }
 
